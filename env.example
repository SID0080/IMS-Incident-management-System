# Copy this file to .env and fill in your own values.
# The .env file is git-ignored and must never be committed.

# ── Database ──────────────────────────────────────────────
# Special characters in the password must be URL-encoded
# (@ -> %40, # -> %23, $ -> %24)
DATABASE_URL=postgresql+asyncpg://username:password@localhost:5432/ims_db

# ── Security ──────────────────────────────────────────────
# Generate a random value for any non-local deployment:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=replace-with-a-random-secret
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# ── Application ───────────────────────────────────────────
DEBUG=True
APP_NAME=Incident Management System
VERSION=1.0.0

# ── Machine learning ──────────────────────────────────────
ML_MODEL_PATH=app/ml/models/categorizer.joblib
TF_MODEL_PATH=app/ml/models/image_classifier
ML_CONFIDENCE_THRESHOLD=0.6

# ── SLA response windows (hours) ──────────────────────────
SLA_LOW_RESPONSE_HRS=24
SLA_MEDIUM_RESPONSE_HRS=8
SLA_HIGH_RESPONSE_HRS=2
SLA_CRITICAL_RESPONSE_HRS=0.5

# ── Email notifications ───────────────────────────────────
# For Gmail, use an App Password, not the account password.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@example.com
SMTP_PASSWORD=your-app-password
ALERT_EMAIL_FROM=ims-alerts@example.com
